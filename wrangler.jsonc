{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app21",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "2c6309ec-5d76-4180-8c85-7709b136ed24","database_name": "nova_proxy" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "9d5fdb9f63d741aabd7f6f267732d558" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
